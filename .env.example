# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Image Generation ──────────────────────────────────────────────────────────
# dall-e-3 (default, quality=hd) or gpt-image-1 (if API access available, quality=high)
IMAGE_MODEL=dall-e-3
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=hd

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=  # only needed for Qdrant Cloud

# Collection names
KB_COLLECTION=course_knowledge_base
POSTS_COLLECTION=generated_posts

# ── Tavily ────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...
TAVILY_MAX_RESULTS=5

# ── X / Twitter ───────────────────────────────────────────────────────────────
X_BEARER_TOKEN=AAAA...
X_MAX_RESULTS=10

# ── LangSmith (optional — traces when set) ────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=ai-content-creator
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Agent Tuning ──────────────────────────────────────────────────────────────
RELEVANCE_THRESHOLD=0.50
DEDUP_THRESHOLD=0.85
DEFAULT_K=5
HYDE_ENABLED=true

# ── Content Domain ────────────────────────────────────────────────────────────
CONTENT_DOMAIN=Generative AI

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ── Cohere (required for Contextual Compression / Rerank — Module 11 eval) ───
# Free key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=...
